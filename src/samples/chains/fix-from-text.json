{
  "title": "Fix a bug from a description",
  "description": "Describe a bug in plain words. An agent fixes it on a new branch, a second agent reviews the change blind, the tests run, you approve the diff, and it is committed and pushed. What the run learned goes into this folder's memory.",
  "subject": "{{request}}",
  "inputs": [
    { "name": "request", "label": "What is wrong" },
    { "name": "test_command", "label": "Test command", "optional": true }
  ],
  "steps": [
    {
      "id": "branch",
      "title": "Start a branch",
      "tool": "start_branch"
    },
    {
      "id": "fix",
      "title": "Fix it",
      "agent": "fix",
      "tools": ["Bash", "Read", "Grep", "Glob", "Write", "Edit"]
    },
    {
      "id": "diff",
      "title": "Collect the change",
      "tool": "capture_diff"
    },
    {
      "id": "review",
      "title": "Blind review by a second agent",
      "agent": "review-change",
      "tools": ["Bash", "Read", "Grep", "Glob"],
      "stop_if": "verdict != APPROVE",
      "stop": "The reviewer asked for changes. {{findings}}"
    },
    {
      "id": "test",
      "title": "Run the tests",
      "tool": "run_tests",
      "with": { "command": "{{test_command}}", "fallback": "{{fix.test_command}}" }
    },
    {
      "id": "approve",
      "title": "Your approval to commit and push",
      "user": "Commit this change on {{branch.branch}} and push it?",
      "show": ["{{run_folder}}/change.diff"]
    },
    {
      "id": "commit",
      "title": "Commit",
      "tool": "commit_change",
      "with": { "message": "{{fix.commit_message}}" }
    },
    {
      "id": "push",
      "title": "Push the branch",
      "tool": "push_branch"
    },
    {
      "id": "learn",
      "title": "Decide what to remember",
      "agent": "learn",
      "tools": ["Read", "Grep", "Glob"],
      "always": true,
      "when": "fix.summary != "
    },
    {
      "id": "remember",
      "title": "Save it to this folder's memory",
      "tool": "remember",
      "with": { "notes": "{{learn.notes}}", "about": "{{request}}" },
      "always": true,
      "when": "learn.notes != "
    }
  ]
}
